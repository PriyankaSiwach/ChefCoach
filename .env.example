# Copy to .env.local and fill in values.
# Get service role key from Supabase Dashboard → Settings → API → service_role (secret)

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Required for account deletion (removes email from auth.users via the local API server)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server only. Never prefix with VITE_: anything named VITE_* is shipped to the browser/app bundle.
OPENAI_API_KEY=your_openai_key

# Required for iOS/Android builds: origin of the deployed API server (no trailing slash).
# VITE_API_BASE_URL=https://api.yourdomain.com
