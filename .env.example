# Copy to .env.local and fill in values.
# Get service role key from Supabase Dashboard → Settings → API → service_role (secret)

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Required for account deletion (removes email from auth.users via the local API server)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server only. Never prefix with VITE_: anything named VITE_* is shipped to the browser/app bundle.
OPENAI_API_KEY=your_openai_key

# Server only. RevenueCat → Project settings → API keys → + New → V2 secret key
# with ONLY "Customer information → Customers: Read only". Used by /api/subscription/refresh.
REVENUECAT_SECRET_KEY=your_revenuecat_v2_read_only_secret_key
# RevenueCat project ID (starts with "proj") and the Pro entitlement's ID (starts with "entl", not "pro").
REVENUECAT_PROJECT_ID=projXXXXXXXX
REVENUECAT_ENTITLEMENT_ID=entlXXXXXXXX
# Optional: Supabase user IDs that always get Pro for free, comma-separated.
# PRO_COMP_USER_IDS=00000000-0000-0000-0000-000000000000

# Required for iOS/Android builds: origin of the deployed API server (no trailing slash).
# VITE_API_BASE_URL=https://api.yourdomain.com
